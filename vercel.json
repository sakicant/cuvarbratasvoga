{
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf vercel-out && mkdir vercel-out && cp -r preview/. vercel-out/ && cp -r assets vercel-out/assets",
  "outputDirectory": "vercel-out",
  "redirects": [
    { "source": "/preview/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": false },
    { "source": "/(o-nama|povijest|mediji|prijava|kontakt|privatnost)\.php", "destination": "/$1.html", "permanent": false }
  ]
}
