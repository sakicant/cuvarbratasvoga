# Početna stranica
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# stare adrese (.html) -> nove (.php)
RewriteRule ^(index|o-nama|povijest|mediji|prijava|kontakt|privatnost)\.html$ $1.php [R=301,L,QSA]
</IfModule>

# Tekstovi i pomoćne PHP datoteke nisu za izravan pristup
<IfModule mod_alias.c>
RedirectMatch 403 ^/(lang|inc|tools)/
</IfModule>

Options -Indexes
